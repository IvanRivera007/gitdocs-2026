(defun COL_TX (x y h j s) (entmake (list (cons 0 "TEXT") (cons 8 (getvar "CLAYER")) (cons 10 (list x y 0.0)) (cons 11 (list x y 0.0)) (cons 40 h) (cons 1 s) (cons 72 j) (cons 73 2))))
(defun COL_DT (s / e) (setq e (entget (entlast))) (entmod (subst (cons 1 s) (assoc 1 e) e)) (princ))
