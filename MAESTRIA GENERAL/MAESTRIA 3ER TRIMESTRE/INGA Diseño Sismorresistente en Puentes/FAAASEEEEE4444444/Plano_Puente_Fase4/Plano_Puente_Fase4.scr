; =====================================================================
; PRESENTACION A3  'E-01'
; =====================================================================
(if (not (member "E-01" (layoutlist))) (command "_.LAYOUT" "_N" "E-01"))
(setvar "CTAB" "E-01")
_.PSPACE
; configuracion de pagina: DWG To PDF.pc3, ISO full bleed A3, 1:1, monochrome.ctb
(vl-load-com)
(setq PLN_LAY (vla-get-ActiveLayout (vla-get-ActiveDocument (vlax-get-acad-object))))
(vl-catch-all-apply (quote vla-put-ConfigName) (list PLN_LAY "DWG To PDF.pc3"))
(vl-catch-all-apply (quote vla-put-CanonicalMediaName) (list PLN_LAY "ISO_full_bleed_A3_(420.00_x_297.00_MM)"))
(vl-catch-all-apply (quote vla-put-PaperUnits) (list PLN_LAY 1))
(vl-catch-all-apply (quote vla-put-PlotType) (list PLN_LAY 5))
(vl-catch-all-apply (quote vla-put-StandardScale) (list PLN_LAY 16))
(vl-catch-all-apply (quote vla-put-StyleSheet) (list PLN_LAY "monochrome.ctb"))
(vl-catch-all-apply (quote vla-put-PlotWithLineweights) (list PLN_LAY :vlax-true))
(vl-catch-all-apply (quote vla-put-CenterPlot) (list PLN_LAY :vlax-false))
(vl-catch-all-apply (quote vla-put-PlotOrigin) (list PLN_LAY (vlax-make-variant (vlax-safearray-fill (vlax-make-safearray vlax-vbDouble (quote (0 . 1))) (list 0.0 0.0)))))
(if (not (vl-catch-all-error-p (vl-catch-all-apply (quote vla-GetPaperSize) (list PLN_LAY (quote PLN_PW) (quote PLN_PH))))) (vl-catch-all-apply (quote vla-put-PlotRotation) (list PLN_LAY (if (> PLN_PW PLN_PH) 0 1))))
_.REGENALL
