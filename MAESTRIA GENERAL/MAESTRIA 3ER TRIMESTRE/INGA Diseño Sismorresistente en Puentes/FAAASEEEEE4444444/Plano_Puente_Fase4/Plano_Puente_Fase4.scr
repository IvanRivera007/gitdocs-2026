(PLN_TX 1 "TEXTOS" 18 50.6 2.5 0.000000 0 0 "ESPECIFICACIONES Y NOTAS")
(PLN_TX 1 "TEXTOS" 18 45.6 1.8 0.000000 0 0 "1. COTAS EN MIL\\U+00CDMETROS. GEOMETR\\U+00CDA DE MODEL SPACE A TAMA\\U+00D1O REAL; ESCALAS DE IMPRESI\\U+00D3N EN LAS VENTANAS DE PRESENTACI\\U+00D3N.")
(PLN_TX 1 "TEXTOS" 18 41.85 1.8 0.000000 0 0 "2. PUENTE DE 3 TRAMOS 22.50 + 30.00 + 22.50 = 75.00 m; ANCHO DE SUPERESTRUCTURA 9.60 m; 4 VIGAS AASHTO TIPO IV.")
(PLN_TX 1 "TEXTOS" 18 38.1 1.8 0.000000 0 0 "3. MARCO: 2 COLUMNAS %%c 1200 mm, ALTURA LIBRE 7000 mm, EJES A 6000 mm; CABEZAL 1500 x 1500 mm, L = 9600 mm, VOLADIZOS 1800 mm.")
(PLN_TX 1 "TEXTOS" 18 34.35 1.8 0.000000 0 0 "4. REFUERZO LONGITUDINAL: 26 VARILLAS No. 14 (%%c 43 mm) EN DISTRIBUCI\\U+00D3N POLAR, 360%%d/26 = 13.846%%d, R EJE BARRAS = 502.3 mm.")
(PLN_TX 1 "TEXTOS" 18 30.6 1.8 0.000000 0 0 "5. REFUERZO TRANSVERSAL: AROS CIRCULARES No. 8 (%%c 25.4 mm) @ 127 mm (5 in); %%c EJE A EJE DEL ARO = 1073.0 mm.")
(PLN_TX 1 "TEXTOS" 18 26.85 1.8 0.000000 0 0 "6. RECUBRIMIENTO LIBRE AL ARO: 50.8 mm. ZONA DE CONFINAMIENTO ESPECIAL: 1800 mm EN CADA EXTREMO DE LA COLUMNA.")
(PLN_TX 1 "TEXTOS" 18 23.1 1.8 0.000000 0 0 "7. Lp ANAL\\U+00CDTICA (R\\U+00D3TULA PL\\U+00C1STICA) = 851 mm: DATO DEL MODELO; NO ES LA LONGITUD DE CONFINAMIENTO (1800 mm).")
(PLN_TX 1 "TEXTOS" 18 19.35 1.8 0.000000 0 0 "8. NO SE DEFINEN EN ESTA L\\U+00C1MINA: ZAPATAS, ANCLAJES, TRASLAPES, GANCHOS NI MATERIALES (f'c, fy).")
(PLN_TX 1 "TEXTOS" 18 15.6 1.8 0.000000 0 0 "9. DETALLADO ACAD\\U+00C9MICO DEL MODELO UTILIZADO. NO CONSTITUYE DECLARACI\\U+00D3N DE CUMPLIMIENTO DE DISE\\U+00D1O NI NORMATIVO.")
