; ---------------- estilo de texto
(if (not (tblsearch "STYLE" "PLANO")) (entmake (list (quote (0 . "STYLE")) (quote (100 . "AcDbSymbolTableRecord")) (quote (100 . "AcDbTextStyleTableRecord")) (quote (2 . "PLANO")) (quote (70 . 0)) (quote (40 . 0.0)) (quote (41 . 1.0)) (quote (50 . 0.0)) (quote (71 . 0)) (quote (42 . 2.5)) (quote (3 . "arial.ttf")) (quote (4 . "")))))
(defun PLN_TX (sp ly x y h r jh jv s) (entmake (list (cons 0 "TEXT") (cons 67 sp) (cons 410 (if (= sp 1) (getvar "CTAB") "Model")) (cons 8 ly) (cons 10 (list x y 0.0)) (cons 40 h) (cons 1 s) (cons 50 r) (cons 41 1.0) (cons 7 "PLANO") (cons 72 jh) (cons 11 (list x y 0.0)) (cons 73 jv))))
(defun PLN_DT (s / e) (setq e (entget (entlast))) (entmod (subst (cons 1 s) (assoc 1 e) e)) (entupd (entlast)) (princ))
